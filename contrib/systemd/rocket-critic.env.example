# Environment for the rocket-critic service. Copy to
# ~/.config/rocket-critic/rocket-critic.env and chmod 600.
# Lines are KEY=value; no "export", no quotes needed.

# rocket-critic's own gh calls (listing PRs, cloning) when gh can't read a
# desktop keyring under systemd. Any token that can read the watched repos.
# /code-review also posts with it, unless [github_app] or a GH_TOKEN in
# [claude.env] is configured.
#GH_TOKEN=ghp_...

# Only if [claude.env] uses GH_TOKEN = "${ROCKET_CRITIC_GH_TOKEN}" and you don't
# use [github_app].
#ROCKET_CRITIC_GH_TOKEN=github_pat_...

# Override the poll period without editing config.toml.
#ROCKET_CRITIC_POLL_INTERVAL=2m
