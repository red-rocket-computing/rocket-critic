#!/usr/bin/env python3
"""Fake `gh` for tests. Serves canned data from $FAKE_GH_DATA (JSON)."""
import json
import os
import sys

args = sys.argv[1:]
data = json.load(open(os.environ["FAKE_GH_DATA"]))
with open(os.environ["FAKE_GH_DATA"] + ".log", "a") as log:
    log.write(json.dumps(args) + "\n")


def out(obj):
    print(json.dumps(obj))
    sys.exit(0)


def pages(items, size=2):
    """Paginated output as gh before 2.48 prints it: one JSON array per page, back to back."""
    chunks = [items[i:i + size] for i in range(0, len(items), size)] or [[]]
    print("".join(json.dumps(c) for c in chunks))
    sys.exit(0)


if "--slurp" in args:
    print("unknown flag: --slurp\n\nUsage:  gh api <endpoint> [flags]\n  --verbose   Include full HTTP", file=sys.stderr)
    sys.exit(1)


if args[:2] == ["auth", "status"]:
    print("github.com\n  ✓ Logged in to github.com account tester")
    sys.exit(0)
path = next((a for a in args if a.startswith("repos/")), "")
route = path.split("?", 1)[0]
if path.startswith("repos/o/missing"):
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    sys.exit(1)
if args[0] == "api" and "/releases/" in route:
    releases = data.get("releases", [])
    if route.endswith("/releases/latest") and releases:
        out(releases[0])
    if "/releases/tags/" in route:
        tag = route.rsplit("/", 1)[-1]
        for rel in releases:
            if rel["tag_name"] == tag:
                out(rel)
    if "/releases/assets/" in route and "Accept: application/octet-stream" in args:
        path = data.get("asset_files", {}).get(route.rsplit("/", 1)[-1])
        if path:
            sys.stdout.buffer.write(open(path, "rb").read())
            sys.exit(0)
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    sys.exit(1)
if args[0] == "api" and route.endswith("/pulls"):
    # List form: no additions/deletions.
    pages([{k: v for k, v in pr.items() if k not in ("additions", "deletions")} for pr in data.get("prs", [])])
if args[0] == "api" and route.count("/") == 4 and route.split("/")[3] == "pulls":
    num = int(path.rsplit("/", 1)[-1])
    for pr in data.get("prs", []):
        if pr["number"] == num:
            out(pr)
    print("gh: Not Found (HTTP 404)", file=sys.stderr)
    sys.exit(1)
if args[:2] == ["api", "user"]:
    login = data.get("logins", {}).get(os.environ.get("GH_TOKEN", ""), data.get("login"))
    if not login:
        sys.exit(1)
    print(login)
    sys.exit(0)
def save():
    json.dump(data, open(os.environ["FAKE_GH_DATA"], "w"))


if args[0] == "api" and route.endswith("/reactions"):
    comment_id = int(route.split("/")[-2])
    content = next(a.split("=", 1)[1] for a in args if a.startswith("content="))
    data.setdefault("reactions", []).append({"comment_id": comment_id, "content": content,
                                             "token": os.environ.get("GH_TOKEN", "")})
    save()
    out({})
if args[0] == "api" and "DELETE" in args and "/labels/" in route:
    from urllib.parse import unquote
    num, label = int(route.split("/")[-3]), unquote(route.split("/")[-1])
    for pr in data.get("prs", []):
        if pr["number"] == num:
            pr["labels"] = [lbl for lbl in pr.get("labels", []) if lbl["name"] != label]
    data.setdefault("removed_labels", []).append({"pr": num, "label": label, "token": os.environ.get("GH_TOKEN", "")})
    save()
    out({})
if args[0] == "api" and route.endswith("/issues/comments"):  # repo-wide feed
    pages(data.get("issue_comments", []))
if args[0] == "api" and route.endswith("/reviews") and "POST" in args:
    payload = json.loads(sys.stdin.read())
    if payload.get("comments") and os.environ.get("FAKE_GH_REJECT_INLINE"):
        print("gh: Unprocessable Entity (HTTP 422): Line could not be resolved", file=sys.stderr)
        sys.exit(1)
    if os.environ.get("FAKE_GH_POST_ERROR"):
        print(os.environ["FAKE_GH_POST_ERROR"], file=sys.stderr)
        sys.exit(1)
    import time
    login = data.get("logins", {}).get(os.environ.get("GH_TOKEN", ""), data.get("login"))
    review = {"id": len(data.get("reviews", [])) + 1, "user": {"login": login}, "commit_id": payload.get("commit_id"),
              "submitted_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    data.setdefault("reviews", []).append(review)
    data.setdefault("posted_reviews", []).append({"pr": int(route.split("/")[-2]), "payload": payload,
                                                  "token": os.environ.get("GH_TOKEN", "")})
    save()
    if os.environ.get("FAKE_GH_POST_STDOUT"):
        print(os.environ["FAKE_GH_POST_STDOUT"])
        sys.exit(0)
    out(review)
if args[0] == "api" and route.endswith("/reviews"):
    pages(data.get("reviews", []))
if args[0] == "api" and route.endswith("/comments") and "/pulls/" in route:
    pages(data.get("comments", []))
if args[0] == "api" and route.endswith("/timeline"):
    pages(data.get("timeline", []))
if args[0] == "api" and route.endswith("/comments") and "/issues/" in route:
    pages(data.get("issue_comments", []))
print(f"fake gh: unsupported {args}", file=sys.stderr)
sys.exit(2)
