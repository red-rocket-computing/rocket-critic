#!/usr/bin/env python3
"""Fake `systemctl` for service tests: records calls, answers a few queries."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_SYSTEMD_LOG"], "a") as fh:
    fh.write(json.dumps(["systemctl", *args]) + "\n")
if "show" in args and "MainPID" in args:
    print(os.environ.get("FAKE_SYSTEMD_MAINPID", "0"))
elif "is-enabled" in args:
    print("enabled")
elif "is-active" in args:
    print("active")
sys.exit(int(os.environ.get("FAKE_SYSTEMD_EXIT", "0")))
