#!/usr/bin/env python3
"""Fake `loginctl` for service tests."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_SYSTEMD_LOG"], "a") as fh:
    fh.write(json.dumps(["loginctl", *args]) + "\n")
if args[:1] == ["show-user"]:
    print(os.environ.get("FAKE_LINGER", "no"))
