#!/usr/bin/env python3
"""Fake `claude` for tests: records how it was called and prints a canned result."""
import json
import os
import subprocess
import sys

if sys.argv[1:] == ["--version"]:
    print("9.9.9 (Claude Code)")
    sys.exit(0)

record = {
    "argv": sys.argv[1:],
    "cwd": os.getcwd(),
    "env": {k: v for k, v in os.environ.items() if k.startswith(("ANTHROPIC_", "GH_", "CLAUDE_"))},
    "head": subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip(),
}
with open(os.environ["FAKE_CLAUDE_LOG"], "a") as fh:
    fh.write(json.dumps(record) + "\n")

if os.environ.get("FAKE_CLAUDE_POST"):
    # Simulate /code-review --comment posting a review before the run ends.
    import time
    path = os.environ["FAKE_GH_DATA"]
    data = json.load(open(path))
    login = data.get("logins", {}).get(os.environ.get("GH_TOKEN", ""), data.get("login"))
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    data.setdefault("reviews", []).append({"user": {"login": login}, "commit_id": record["head"],
                                           "submitted_at": stamp})
    json.dump(data, open(path, "w"))

result = os.environ.get("FAKE_CLAUDE_RESULT")
if result:
    print(open(result).read())
else:
    print(json.dumps({
        "type": "result", "subtype": "success", "is_error": False,
        "result": "Found 1 issue; posted 1 inline comment.",
        "total_cost_usd": 0.0, "duration_ms": 1234, "num_turns": 7, "permission_denials": [],
    }))
sys.exit(int(os.environ.get("FAKE_CLAUDE_EXIT", "0")))
